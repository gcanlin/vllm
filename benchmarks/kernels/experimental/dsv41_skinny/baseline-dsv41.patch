     assert sparse_indices[0].cpu().tolist() == [0, 1, 2, 3, -1, -1, -1, -1]
     assert sparse_lens.cpu().tolist() == [padded_width]
+
+
+@pytest.mark.parametrize("compress_ratio", [1, 2])
+@pytest.mark.parametrize("num_decodes", [0, 1, 2])
+def test_dsv41_sparse_source_reuse_and_invalidation(
+    compress_ratio, num_decodes, monkeypatch
+):
+    """Reuse exact mappings, but refresh after source writes and batch changes."""
+    from types import SimpleNamespace
+
+    from vllm.models.deepseek_v4_1.nvidia import flashinfer_sparse as fi
+    from vllm.v1.attention.backends.mla.sparse_swa import DeepseekSparseSWAMetadata
+
+    monkeypatch.setenv("VLLM_DSV41_REUSE_SPARSE_INDICES", "1")
+    device = "cuda"
+    topk = torch.tensor([[0, 1], [1, 2]], dtype=torch.int32, device=device)
+    table = torch.tensor([[1], [2]], dtype=torch.int32, device=device)
+    swa = DeepseekSparseSWAMetadata(
+        block_table=table,
+        slot_mapping=torch.zeros(2, dtype=torch.int64, device=device),
+        block_size=64,
+        seq_lens=torch.tensor([8, 10], dtype=torch.int32, device=device),
+        query_start_loc=torch.arange(3, dtype=torch.int32, device=device),
+        token_to_req_indices=torch.arange(2, dtype=torch.int32, device=device),
+        decode_swa_indices=torch.tensor(
+            [[68, 69, 70, 71], [134, 135, 136, 137]],
+            dtype=torch.int32,
+            device=device,
+        )[:num_decodes],
+        decode_swa_width=4,
+        is_valid_token=torch.ones(num_decodes, dtype=torch.bool, device=device),
+        num_decodes=num_decodes,
+        num_prefills=2 - num_decodes,
+        num_decode_tokens=num_decodes,
+        num_prefill_tokens=2 - num_decodes,
+    )
+    compressed = SimpleNamespace(block_table=table, block_size=64)
+    source = object.__new__(fi.DeepseekV4FlashInferMLAAttention)
+    consumer = object.__new__(fi.DeepseekV4FlashInferMLAAttention)
+    for layer in (source, consumer):
+        layer.compress_ratio = compress_ratio
+        layer.window_size = 4
+        layer.topk_indices_buffer = topk
+        layer.index_source_layer_id = 20
+        layer.kv_source_layer_id = 20
+    source.is_index_source = True
+    consumer.is_index_source = False
+    pool = torch.empty((3, 64, 8), device=device)
+
+    def build(layer, kv=pool):
+        return layer._build_sparse_index_metadata(kv, pool, swa, compressed, False)[2:]
+
+    first = build(source)
+    reused = build(consumer)
+    assert reused[0] is first[0]
+    assert reused[1] is first[1]
+    original = first[0].clone()
+    topk.add_(1)
+    refreshed = build(source)
+    assert refreshed[0] is not first[0]
+    assert not torch.equal(refreshed[0], original)
+    assert build(consumer)[0] is refreshed[0]
+
+    # A different index source overwrites the same top-k allocation.
+    consumer.index_source_layer_id = 24
+    assert build(consumer)[0] is not refreshed[0]
+    consumer.index_source_layer_id = 20
+    # Packed page geometry must not reuse an unpacked physical mapping.
+    packed = torch.empty((3, 128, 8), device=device)[:, :64]
+    packed_result = build(consumer, packed)
+    assert not torch.equal(packed_result[0], refreshed[0])
+    # Updated block tables in the next batch must be converted again.
+    swa.flashinfer_sparse_index_cache.clear()
+    table.add_(1)
+    next_batch = build(consumer)
+    assert not torch.equal(next_batch[0], refreshed[0])
+
+    # Capture must retain the source conversion, with consumers sharing its
+    # output; replay reads fresh top-k values at the same input address.
+    for _ in range(2):
+        build(source)
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        captured_source = build(source)
+        captured_consumer = build(consumer)
+    assert captured_source[0] is captured_consumer[0]
+    topk.sub_(1)
+    graph.replay()
+    torch.cuda.synchronize()
+    expected = build(source)
+    torch.testing.assert_close(captured_consumer[0], expected[0], rtol=0, atol=0)
+    torch.testing.assert_close(captured_consumer[1], expected[1], rtol=0, atol=0)
+
+    monkeypatch.setenv("VLLM_DSV41_REUSE_SPARSE_INDICES", "0")
+    uncached = build(consumer)
+    assert build(consumer)[0] is not uncached[0]
+    torch.testing.assert_close(uncached[0], expected[0], rtol=0, atol=0)
